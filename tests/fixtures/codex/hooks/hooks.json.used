{
  "description": "vt-m0 capture hooks (Vambiant Term M0 verification)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py SessionStart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py SessionEnd",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py PreToolUse"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py PermissionRequest"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py Stop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py PreCompact"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py PostCompact"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py SubagentStop"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /tmp/vt-m0/codex/hooks/capture.py Interrupt",
            "timeout": 3
          }
        ]
      }
    ]
  }
}